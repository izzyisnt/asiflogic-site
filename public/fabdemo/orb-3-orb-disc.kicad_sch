	(label "VBUS24" (at 76.2 58.42 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "71189da1-29d2-5943-af4c-5600bb24ecb8"))
	(label "+5V_LED" (at 190.5 78.74 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5f4bf2ec-a955-5295-a423-b2f33b0dbfa8"))
	(label "FB" (at 190.5 92.71 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4226a143-74ae-574a-a72e-991b3a4a4331"))
	(label "DATA_IN" (at 63.5 144.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "82111d07-1714-56a6-a9bc-18dd777e41b9"))
	(label "SDA" (at 88.9 165.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "eabfffb1-9166-5f05-bed6-642cac7016f4"))
	(label "SCL" (at 88.9 167.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6af6475b-8d72-5aed-ab12-7fc47cd8e0a0"))
	(label "W_PWM_A" (at 127 198.12 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b1f13245-289f-5f4b-a138-bf8a103538ff"))
	(label "W_PWM_B" (at 127 231.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0735ad0a-f068-5d1c-8d95-cacb8d7968e8"))
	(text "16 pixels, ONE chain. WLED's four \"segments\" are software divisions of this single chain — one per sphere — not four wires." (exclude_from_sim no) (at 76.2 157.48 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "46cd727c-c88e-54f3-9738-c8208f50d7e1"))
	(text "The globe has to breathe: an ePTFE vent, a weep path and a coated board are the defences; U4 is how anyone knows they work. See moistlab/boards/orb_climate.py." (exclude_from_sim no) (at 76.2 170.18 0) (effects (font (size 1.651 1.651)) (justify left)) (uuid "a25ae083-2f66-5631-bf4f-28595dae73ba"))
	(text "X_SKY samples the sky THROUGH the globe, so it reads what the sphere shows - and only while every emitter is blanked. Window held by orb_program." (exclude_from_sim no) (at 190.5 170.18 0) (effects (font (size 1.651 1.651)) (justify left)) (uuid "a85a7073-ade7-55a6-b2a1-efa028c1216b"))
	(text "TWO white channels: 2200 K on U1 and 3000 K on U3, 5s each at 0.15 A. Same ten emitters and the same 4.80 W the single channel drew — what the second driver buys is colour temperature, not light." (exclude_from_sim no) (at 76.2 248.92 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "dc80b69c-232a-5b9d-bc99-0f6f334d3ea6"))
	(text "GENERATED — do not hand-edit. Source: moistlab/boards/orb_disc.py + orb_sheets.py; regenerate with tools/gen_kicad.py" (exclude_from_sim no) (at 25.4 259.08 0) (effects (font (size 2.032 2.032)) (justify left)) (uuid "9d892fc7-0d6f-5b57-93dc-3da66f149984"))
	(text "Provenance: every rating on this sheet is [I] — vendor web copy or folklore. No transcription pass has happened." (exclude_from_sim no) (at 25.4 264.16 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "aa982bc2-8d15-55ae-bc3a-8ab14f19e0d4"))
	(text "Pin numbers are hidden on parts whose package pinout has NOT been transcribed. Only the 74AHCT125 shows its numbers." (exclude_from_sim no) (at 25.4 269.24 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "08daad33-9ea0-5e03-8633-8b1c9c93b40b"))
	(text "Per disc [I]: white 4.80 W at the LEDs, pixels 5.12 W at the ring, 11.67 W at the bus after 85% conversion. Four discs + base = 48.6 W per post." (exclude_from_sim no) (at 25.4 274.32 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "c5697961-3e83-52cc-aafb-f0463dbfc24e"))
	(text "The 5 V buck is PER DISC on purpose: a base-fed 5 V rail loses a fifth of itself in the riser before the first frame." (exclude_from_sim no) (at 25.4 279.4 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "e53a78a2-024f-5ac5-a54c-ceedbe3758cd"))
	(text "Each white string is 5s at 3.2 V worst-bin Vf = 16 V, plus 0.6 V driver headroom, under the 20 V bus floor." (exclude_from_sim no) (at 25.4 284.48 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "22991e75-1785-5450-8d29-c46d1e078885"))
	(text "Disc is 70 mm through a 101.6 mm globe bore [M operator]." (exclude_from_sim no) (at 25.4 289.56 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "f0885cfb-cf83-5c4e-af17-8d13a3ca962d"))
