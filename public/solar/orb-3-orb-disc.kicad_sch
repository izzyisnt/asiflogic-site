	(label "W_PWM_A" (at 127 198.12 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b1f13245-289f-5f4b-a138-bf8a103538ff"))
	(label "W_PWM_B" (at 127 231.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0735ad0a-f068-5d1c-8d95-cacb8d7968e8"))
	(text "16 pixels, ONE chain. WLED's four \"segments\" are software divisions of this single chain — one per sphere — not four wires." (exclude_from_sim no) (at 76.2 157.48 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "46cd727c-c88e-54f3-9738-c8208f50d7e1"))
	(text "The globe has to breathe: vent + weep + coating are the defences; U4 is how anyone knows they work (orb_climate.py)." (exclude_from_sim no) (at 76.2 170.18 0) (effects (font (size 1.651 1.651)) (justify left)) (uuid "c0eab0b1-364d-5f27-912f-dfa357345195"))
	(text "U5 reads the sky THROUGH the globe (TI: characterized under dark cover glass), and only while every emitter is blanked." (exclude_from_sim no) (at 172.72 223.52 0) (effects (font (size 1.651 1.651)) (justify left)) (uuid "f55c2977-4a9c-5472-a903-f4afada1f2eb"))
	(text "Sample window: one skipped frame - held by orb_program, not by this sheet." (exclude_from_sim no) (at 172.72 227.33 0) (effects (font (size 1.651 1.651)) (justify left)) (uuid "cfafbba2-b5fb-5336-bdd9-91ce848537e3"))
	(text "TWO white channels: 2200 K on U1, 3000 K on U3, 5s at 0.15 A each." (exclude_from_sim no) (at 25.4 250.19 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "f2d7c5d6-2d11-595f-b2e1-0f66c6b22167"))
	(text "Same ten emitters, same 4.80 W — the second driver buys colour temperature." (exclude_from_sim no) (at 25.4 254 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "29c36e5d-2832-5d7c-8f89-dcb9891e57f5"))
	(text "GENERATED — do not hand-edit. Source: moistlab/boards/orb_disc.py + orb_sheets.py; regenerate with tools/gen_kicad.py" (exclude_from_sim no) (at 25.4 259.08 0) (effects (font (size 2.032 2.032)) (justify left)) (uuid "9d892fc7-0d6f-5b57-93dc-3da66f149984"))
	(text "Provenance: ratings are [I] vendor web copy unless the part's note cites a document number — [M] only with a citation (first: U5/OPT4048, TI SBOSA84, 2026-08-03)." (exclude_from_sim no) (at 25.4 264.16 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "5ce95e1d-b81b-5281-adf4-cc4a08afda3b"))
	(text "Pin numbers are hidden on parts whose package pinout has NOT been transcribed. Only the 74AHCT125 and the OPT4048 have earned theirs." (exclude_from_sim no) (at 25.4 269.24 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "cb6018e4-82f0-5a2e-97d3-761961b47c25"))
	(text "Per disc [I]: white 4.80 W + pixels 5.12 W = 11.67 W at the bus; four discs + base = 48.6 W per post." (exclude_from_sim no) (at 25.4 274.32 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "2e504f05-6c1e-5d63-af0c-fa9809a0d377"))
	(text "5 V buck PER DISC (base-fed 5 V loses a fifth in the riser); white strings 5s at 3.2 V worst-bin Vf under the 20 V floor." (exclude_from_sim no) (at 25.4 279.4 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "329d5026-b150-53be-8ba7-64a6d5457b6a"))
	(text "Disc is 70 mm through a 101.6 mm globe mount ID [M operator, corrected 2026-08-02]." (exclude_from_sim no) (at 25.4 284.48 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "08cf507c-f2ba-5fe5-af81-0b07214b7385"))
